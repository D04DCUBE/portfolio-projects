    "test": "node --test",
    "eval": "node eval/run.js",
    "e2e": "playwright test",
    "e2e:api": "playwright test --project=api",
    "e2e:ui": "playwright test --project=ui"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  }
}
