{
  "name": "operator-screen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A touch-only operator screen for a simulated pharmacy machine. React 19, TypeScript, Tailwind 4. The screen owns no domain state: it renders what the machine sends over a WebSocket. All data is fake.",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "contract": "node scripts/gen-contract.ts",
    "contract:check": "node scripts/gen-contract.ts --check",
    "lint": "node scripts/lint-tokens.ts",
    "build": "node scripts/gen-contract.ts --check && node scripts/build.ts",
    "start": "npm run build && node server/main.ts",
    "test": "node --test --experimental-test-coverage test/*.test.ts",
    "e2e": "npm run build && node --test e2e/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.50.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0"
  }
}
