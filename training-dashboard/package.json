{
  "name": "training-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A dashboard for comparing model training runs, with live charts. TypeScript, runs are simulated, no runtime dependencies.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node server.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:api": "playwright test --project=api",
    "e2e:ui": "playwright test --project=ui"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  }
}
